{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/store.html"
    },
    {
      "source": "/landing",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/store",
      "destination": "/store.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/pos",
      "destination": "/admin.html"
    },
    {
      "source": "/product-images",
      "destination": "/product-images.html"
    },
    {
      "source": "/photo",
      "destination": "/product-images.html"
    },
    {
      "source": "/photos",
      "destination": "/product-images.html"
    },
    {
      "source": "/image-studio",
      "destination": "/product-images.html"
    },
    {
      "source": "/studio",
      "destination": "/product-images.html"
    },
    {
      "source": "/marketing",
      "destination": "/marketing.html"
    },
    {
      "source": "/sns-marketing",
      "destination": "/marketing.html"
    },
    {
      "source": "/sns",
      "destination": "/marketing.html"
    },
    {
      "source": "/markbot",
      "destination": "/marketing.html"
    },
    {
      "source": "/rani",
      "destination": "/rani.html"
    },
    {
      "source": "/master",
      "destination": "/master.html"
    },
    {
      "source": "/master-login",
      "destination": "/master-login.html"
    },
    {
      "source": "/ai-analytics",
      "destination": "/ai-analytics.html"
    },
    {
      "source": "/bill_history",
      "destination": "/bill_history.html"
    },
    {
      "source": "/diagnostics",
      "destination": "/diagnostics.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/orders",
      "destination": "/orders.html"
    },
    {
      "source": "/online-orders",
      "destination": "/orders.html"
    },
    {
      "source": "/presentation",
      "destination": "/presentation.html"
    },
    {
      "source": "/ppt",
      "destination": "/presentation.html"
    },
    {
      "source": "/deck",
      "destination": "/presentation.html"
    },
    {
      "source": "/display/overhead-promos",
      "destination": "/display/overhead-promos.html"
    },
    {
      "source": "/overhead-promos",
      "destination": "/display/overhead-promos.html"
    },
    {
      "source": "/signage",
      "destination": "/display/overhead-promos.html"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "{public/**,data/**,*.json,posEnhancementService.js,analyticsService.js,generativeAiAdvisor.js,aiProductImageEngine.js,festivalMasterData.js,hypermarketBackend.js}"
    }
  },
  "crons": [
    {
      "path": "/api/supabase/keepalive",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/merchant-feed",
      "schedule": "30 20 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), payment=(self \"https://pay.google.com\")"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, x-admin-key, Authorization"
        }
      ]
    }
  ]
}